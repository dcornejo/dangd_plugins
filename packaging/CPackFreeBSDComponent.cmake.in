# CPack's FreeBSD generator has no component-package mode.  This wrapper loads
# the generated project settings, then restricts one invocation to one named
# CMake install component and gives that package independent metadata.
include("@CMAKE_CURRENT_BINARY_DIR@/CPackConfig.cmake")
set(CPACK_GENERATOR "FREEBSD")
set(CPACK_INSTALL_CMAKE_PROJECTS
  "@CMAKE_CURRENT_BINARY_DIR@;@PROJECT_NAME@;@DANG_PACKAGE_COMPONENT@;/")
set(CPACK_PACKAGE_NAME "@DANG_FREEBSD_PACKAGE_NAME@")
set(CPACK_FREEBSD_PACKAGE_NAME "@DANG_FREEBSD_PACKAGE_NAME@")
set(CPACK_PACKAGE_FILE_NAME
  "@DANG_FREEBSD_PACKAGE_NAME@-@PROJECT_VERSION@")
set(CPACK_FREEBSD_PACKAGE_ORIGIN
  "net-mgmt/@DANG_FREEBSD_PACKAGE_NAME@")
set(CPACK_FREEBSD_PACKAGE_DEPS "@DANG_FREEBSD_PACKAGE_DEPS@")
