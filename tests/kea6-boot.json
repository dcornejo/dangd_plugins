{
  "Dhcp6": {
    "interfaces-config": {"interfaces": ["dangkea0"]},
    "control-sockets": [{
      "socket-type": "unix",
      "socket-name": "/var/run/kea/kea6-ctrl-socket"
    }],
    "lease-database": {"type": "memfile", "persist": false},
    "hooks-libraries": [
      {"library": "@KEA_HOOK_DIR@/libdhcp_lease_cmds.so"},
      {"library": "@KEA_HOOK_DIR@/libdhcp_stat_cmds.so"}
    ],
    "preferred-lifetime": 300,
    "valid-lifetime": 600,
    "loggers": [{
      "name": "kea-dhcp6",
      "severity": "INFO",
      "output-options": [{"output": "stderr"}]
    }]
  }
}
