<routing-instance xmlns="urn:ietf:params:xml:ns:yang:ietf-i2rs-rib">
  <name>default</name>
  <rib-list>
    <name>blue</name>
    <address-family>ipv4-address-family</address-family>
    <route-list>
      <route-index>42</route-index>
      <match>
        <ipv4><dest-ipv4-prefix>192.0.2.0/24</dest-ipv4-prefix></ipv4>
      </match>
      <nexthop>
        <nexthop-id>7</nexthop-id>
        <sharing-flag>true</sharing-flag>
        <nexthop-base>
          <egress-interface-ipv4-address>
            <outgoing-interface>dummy0</outgoing-interface>
            <ipv4-address>198.51.100.1</ipv4-address>
          </egress-interface-ipv4-address>
        </nexthop-base>
      </nexthop>
      <route-status>
        <route-state>active</route-state>
        <route-installed-state>installed</route-installed-state>
      </route-status>
      <route-attributes>
        <route-preference>10</route-preference>
        <local-only>true</local-only>
      </route-attributes>
    </route-list>
    <route-list>
      <route-index>44</route-index>
      <match>
        <ipv4><dest-ipv4-prefix>192.0.2.7/32</dest-ipv4-prefix></ipv4>
      </match>
      <nexthop><nexthop-base><special>receive</special></nexthop-base></nexthop>
      <route-status>
        <route-state>active</route-state>
        <route-installed-state>installed</route-installed-state>
      </route-status>
      <route-attributes>
        <route-preference>0</route-preference>
        <local-only>true</local-only>
      </route-attributes>
    </route-list>
    <route-list>
      <route-index>45</route-index>
      <match>
        <ipv4><dest-ipv4-prefix>198.18.7.0/24</dest-ipv4-prefix></ipv4>
      </match>
      <nexthop>
        <nexthop-lb>
          <nexthop-list>
            <nexthop-member-id>7</nexthop-member-id>
            <nexthop-lb-weight>2</nexthop-lb-weight>
          </nexthop-list>
          <nexthop-list>
            <nexthop-member-id>9</nexthop-member-id>
            <nexthop-lb-weight>3</nexthop-lb-weight>
          </nexthop-list>
        </nexthop-lb>
      </nexthop>
      <route-status>
        <route-state>active</route-state>
        <route-installed-state>installed</route-installed-state>
      </route-status>
      <route-attributes>
        <route-preference>10</route-preference>
        <local-only>false</local-only>
      </route-attributes>
    </route-list>
    <nexthop-list><nexthop-member-id>7</nexthop-member-id></nexthop-list>
    <nexthop-list><nexthop-member-id>9</nexthop-member-id></nexthop-list>
  </rib-list>
  <rib-list>
    <name>red</name>
    <address-family>ipv6-address-family</address-family>
    <route-list>
      <route-index>43</route-index>
      <match>
        <ipv6><dest-ipv6-prefix>2001:db8:1::/64</dest-ipv6-prefix></ipv6>
      </match>
      <nexthop>
        <nexthop-base>
          <egress-interface-ipv6-address>
            <outgoing-interface>dummy0</outgoing-interface>
            <ipv6-address>2001:db8::1</ipv6-address>
          </egress-interface-ipv6-address>
        </nexthop-base>
      </nexthop>
      <route-status>
        <route-state>active</route-state>
        <route-installed-state>installed</route-installed-state>
      </route-status>
      <route-attributes>
        <route-preference>20</route-preference>
        <local-only>false</local-only>
      </route-attributes>
    </route-list>
  </rib-list>
</routing-instance>
